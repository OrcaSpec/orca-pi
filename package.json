{
  "name": "orca-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Orca for pi — an OrcaSpec-powered pi extension that governs the parent session as the steward, routes writable work to structurally determined owners, and enforces authority at the tool level.",
  "keywords": [
    "pi-package",
    "orca",
    "orcaspec",
    "agent",
    "orchestration",
    "authorization"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "orcaspec": "git+ssh://git@github.com/ShadReyes/OrcaSpec.git#v0.1.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "^22.0.0",
    "typebox": "1.1.38",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
